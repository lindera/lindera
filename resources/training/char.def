# Character definition for training
DEFAULT 0 1 0
SPACE 0 1 0
HIRAGANA 1 1 0
KATAKANA 1 1 0
KANJI 0 0 2
ALPHA 1 1 0
NUMERIC 1 1 0

# Character mappings (simplified)
0x0020 SPACE  # 0x0020 is reserved for SPACE
0x0009 SPACE
0x000A SPACE
0x000B SPACE
0x000D SPACE
0x3041..0x3096 HIRAGANA
0x30A1..0x30F6 KATAKANA
0x4E00..0x9FAF KANJI
0x0030..0x0039 NUMERIC
0x0041..0x005A ALPHA
0x0061..0x007A ALPHA
