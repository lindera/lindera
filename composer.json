{
  "$schema": "https://raw.githubusercontent.com/composer/composer/main/res/composer-schema.json",
  "name": "lindera/lindera",
  "description": "PHP extension for Lindera, a multilingual morphological analysis library (no embedded dictionaries)",
  "type": "php-ext",
  "license": "MIT",
  "homepage": "https://github.com/lindera/lindera",
  "keywords": ["morphological-analysis", "tokenizer", "japanese", "korean", "chinese", "nlp", "extension"],
  "support": {
    "issues": "https://github.com/lindera/lindera/issues",
    "source": "https://github.com/lindera/lindera",
    "docs": "https://lindera.github.io/lindera/"
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.18",
    "phpunit/phpunit": "^13.3.1"
  },
  "autoload-dev": {
    "psr-4": {
      "Lindera\\Tests\\": "lindera-php/tests/",
      "Lindera\\Tools\\": "lindera-php/tools/"
    }
  },
  "php-ext": {
    "extension-name": "lindera",
    "build-path": "lindera-php",
    "support-zts": true,
    "support-nts": true,
    "download-url-method": "composer-default",
    "os-families-exclude": ["windows"]
  },
  "config": {
    "sort-packages": true
  }
}
