# Dependencies
node_modules/

# Native binaries are platform-specific and published from CI artifacts.
*.node

# NOTE: index.js and index.d.ts are generated by `napi build` but are COMMITTED,
# matching the napi-rs package-template. They are the package entry points listed
# in `main`/`types`/`files`, so if they are not in the repository they are not in
# the published tarball either (see #832). `make test-lindera-nodejs` regenerates
# them and CI fails if the result differs from what is committed.

# npm
package-lock.json

# Platform-specific npm packages (generated by napi prepublish)
npm/
